<?xml version="1.0" encoding="utf-8"?>
<!-- 注意：allowBackup="false" 已在 AndroidManifest 中设置，此文件为保险配置 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="campus_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="campus_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
